{
  "name": "jodev",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // worker-mailer needs it
  "compatibility_flags": ["nodejs_compat"],
  // Only /api/* runs the Worker first; every page is still served straight from assets
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  // Keeps console.error output (e.g. failed sends) in Workers & Pages > jodev > Logs
  "observability": { "logs": { "enabled": true, "invocation_logs": true, "persist": true } },
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "routes": [
    { "pattern": "jodev.co.za", "custom_domain": true },
    { "pattern": "www.jodev.co.za", "custom_domain": true }
  ]
}
