{
  "name": "jodev",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // worker-mailer needs it
  "compatibility_flags": ["nodejs_compat"],
  // Only /api/* and / run the Worker first (/ so curl gets the terminal card); every other page is served straight from assets
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/"] },
  // Keeps console.error output (e.g. failed sends) in Workers & Pages > jodev > Logs
  "observability": { "logs": { "enabled": true, "invocation_logs": true, "persist": true } },
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // Strava webhook (one shared key) and the admin sync (per IP)
    { "name": "STRAVA_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Strava data (STRAVA.md). No database_id: wrangler creates the database on the first deploy and reuses it after.
  "d1_databases": [{ "binding": "DB", "database_name": "jodev" }],
  // Contact form emails (contact.ts). Create both once with `wrangler queues create <name>`: unlike D1 they aren't made on deploy.
  "queues": {
    "producers": [{ "binding": "CONTACT_QUEUE", "queue": "jodev-contact" }],
    "consumers": [
      // One batch at a time so a backlog can't burst past Zoho's hourly SMTP limit. After 5 retries (about half an hour
      // of backoff) a message moves to the dead-letter queue.
      { "queue": "jodev-contact", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "jodev-contact-dlq" },
      // Saves what's left to D1 (contact_failed)
      { "queue": "jodev-contact-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  // Daily at 03:00 UTC: Strava stats refresh and retries. Every 30 minutes (:13 and :43, matching UPTIME_CRON in
  // uptime.ts): start the Uptime GitHub workflow, which needs the GITHUB_DISPATCH_TOKEN secret.
  "triggers": { "crons": ["0 3 * * *", "13,43 * * * *"] },
  // Every uploaded version gets its own public workers.dev Version URL; the blue-green workflow tests green there.
  // The plain jodev.<subdomain>.workers.dev hostname stays off (workers_dev defaults to false when there are routes).
  "preview_urls": true,
  "routes": [
    { "pattern": "jodev.co.za", "custom_domain": true },
    { "pattern": "www.jodev.co.za", "custom_domain": true }
  ]
}
